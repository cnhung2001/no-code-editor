# ⚠ File này chỉ là mẫu. Biến FRONTEND (VITE_*) đọc từ <root>/.env;
#   biến BACKEND (kể cả secret authz) đọc từ server/.env — xem server/env.mjs.

# ── Frontend (<root>/.env) ─────────────────────────────────────────
# Base URL của backend. Cùng origin với app nên để đường dẫn tương đối.
VITE_API_BASE=/api

# CDN base cho assets công khai. Để trống → dùng presigned URL qua backend.
VITE_CDN_BASE=https://d29yoaro2sdwp8.cloudfront.net

# Bật mock data để chạy thử không cần AWS (true|false).
VITE_USE_MOCK=false

# Khi getValue() trả wrapper { screen_id, label, remote_layout }:
#  - "plain"   → gỡ remote_layout về DivKit thuần (MẤT variables/screen_id/label)
#  - "wrapper" → lưu nguyên wrapper (GIỮ variables/products/screen_id) ← khuyến nghị
VITE_SAVE_FORMAT=wrapper

# Hiển thị URL asset trong editor: false = URL CDN đầy đủ; true = proxy /api/asset (né CORS).
VITE_ASSET_PROXY=false

# ⚠ KHÔNG có VITE_ALLOW_PUSH nữa. Quyền ghi/publish/xoá do authz quyết định lúc
#   runtime (GET /api/me → perms), không phải cờ build-time.


# ── Backend (server/.env) ──────────────────────────────────────────
# Cổng gateway = origin DUY NHẤT của app. Express serve /api + /auth và, ở dev,
# proxy phần còn lại xuống Vite. Mở app tại http://localhost:8080 (KHÔNG phải 5173).
PORT=8080
APP_BASE_URL=http://localhost:8080

# Vite dev server mà gateway proxy tới (chỉ dùng khi NODE_ENV != production).
VITE_DEV_URL=http://localhost:5173

# ── S3 ──
S3_BUCKET=ik-nocode-paywall
PRESIGN_TTL=900
CLOUDFRONT_DISTRIBUTION_ID=
USE_S3_VERSIONING=true

# CORS: để TRỐNG khi frontend đi cùng origin (mặc định). Chỉ đặt khi thật sự có
# client khác origin — bật kèm cookie credentials là mở lỗ nếu đặt sai.
CORS_ORIGIN=

# ⚠ AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY là biến RESERVED.
#   Local: dùng ~/.aws/credentials. Deploy: đặt ở env của host.
AWS_PROFILE=default

# ── authz (sl-authenz) ── https://authz.begamob.com, prod, hardcode trong SDK
# systemCode do team authz cấp; dùng luôn làm OAuth client_id.
AUTHZ_SYSTEM_CODE=slaio

# ⚠ SECRET. Server-side only. TUYỆT ĐỐI không đặt thành VITE_* / NEXT_PUBLIC_*.
AUTHZ_API_KEY=ikame-authz-xxxxx

# Phải khớp TỪNG BYTE với một entry trong allowlist redirectUri của system.
# authz match tuyệt đối: không wildcard, không prefix, dấu "/" cuối cũng tính.
# Mỗi môi trường (local/staging/prod) là một entry riêng phải đăng ký riêng.
AUTHZ_REDIRECT_URI=http://localhost:8080/auth/callback

# ── Machine translation (nút Localize / Translate all) ─────────────
#  - stub     → trả "[locale] text" (placeholder)
#  - google   → Google translate endpoint free (KHÔNG cần key)
#  - rc-admin → service MT rc-admin (Gemini) — cần RC_ADMIN_* bên dưới
MT_PROVIDER=google
RC_ADMIN_BASE_URL=
RC_ADMIN_TOKEN=
RC_ADMIN_PROJECT_ID=
