# ── Frontend (Vite) ────────────────────────────────────────────────
# Base URL của backend proxy. Mặc định gọi /api (đã proxy trong vite.config).
VITE_API_BASE=/api

# CDN base cho assets công khai (nếu có CloudFront). Để trống → dùng presigned URL.
# Ví dụ: https://dxxxx.cloudfront.net
VITE_CDN_BASE=https://d29yoaro2sdwp8.cloudfront.net

# Bật mock data để chạy thử không cần AWS (true|false). Mặc định false = S3 thật.
VITE_USE_MOCK=false

# Cho phép ghi lên S3 (true|false). Mặc định true = bản đầy đủ.
#  - true  → bản admin: xem + sửa + ghi S3 (Push/Save draft/Delete/New layout)
#  - false → bản chỉ xem: xem + sửa thử + Download, KHÔNG ghi S3 (ẩn Push/Save/Delete/New)
VITE_ALLOW_PUSH=false

# Khi getValue() trả wrapper { screen_id, label, remote_layout }:
#  - "plain"   → gỡ remote_layout về DivKit thuần (MẤT variables/screen_id/label — chỉ dùng client cũ)
#  - "wrapper" → lưu nguyên wrapper (GIỮ variables/products/screen_id) ← khuyến nghị cho paywall
VITE_SAVE_FORMAT=wrapper

# Hiển thị URL asset trong editor: false = URL CDN đầy đủ; true = proxy /api/asset (né CORS).
VITE_ASSET_PROXY=false


# ── Backend (server/index.mjs — S3 proxy) ──────────────────────────
# Cổng backend. Vite proxy /api → cổng này.
PORT=8787

# Tên S3 bucket chứa layout + asset.
S3_BUCKET=ik-nocode-paywall

# Thời hạn (giây) presigned URL cho ảnh.
PRESIGN_TTL=900

# CloudFront distribution ID để invalidate cache khi publish (để trống = bỏ qua).
CLOUDFRONT_DISTRIBUTION_ID=

# Bucket có bật S3 Versioning? true = S3 tự giữ bản cũ; false = tự copy .bak trước khi ghi đè.
USE_S3_VERSIONING=true

# Origin được phép gọi backend trực tiếp (CORS). Deploy: đặt = domain frontend.
CORS_ORIGIN=http://localhost:5173

# ⚠ AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY là biến RESERVED → KHÔNG đặt ở đây.
#   Local: dùng ~/.aws/credentials (profile bên dưới). Deploy: đặt ở env của host backend.
AWS_PROFILE=default


# ── Machine translation (nút Localize / Translate all) ─────────────
#  - stub     → trả "[locale] text" (placeholder, không gọi API — dev/test)
#  - google   → Google translate endpoint free (KHÔNG cần key)
#  - rc-admin → service MT rc-admin (Gemini) — cần RC_ADMIN_* bên dưới
MT_PROVIDER=google

# Chỉ dùng khi MT_PROVIDER=rc-admin:
RC_ADMIN_BASE_URL=
RC_ADMIN_TOKEN=
RC_ADMIN_PROJECT_ID=
