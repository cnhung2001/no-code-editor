# ── Backend proxy config ───────────────────────────────────────────────────
PORT=8787

# AWS
AWS_REGION=ap-southeast-1
S3_BUCKET=ik-nocode-paywall
# Credentials: ưu tiên dùng IAM role / shared config (~/.aws). Hoặc đặt thẳng:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Presigned URL hết hạn (giây)
PRESIGN_TTL=900

# CloudFront (tuỳ chọn — để bật invalidate CDN khi publish)
CLOUDFRONT_DISTRIBUTION_ID=

# Bật S3 bucket versioning để rollback (true|false). Nếu false, backup ra <key>.bak
USE_S3_VERSIONING=true

# CORS origin cho frontend dev
CORS_ORIGIN=http://localhost:5173

# ── Postgres (mapping project + audit log) ────────────────────────────────
# Thiếu các biến này → app vẫn chạy nhưng KHÔNG phân quyền theo project và
# KHÔNG ghi audit (AUTHZ_PROJECT_SCOPE tự hạ về 'off').
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nocode
POSTGRES_PASSWORD=
POSTGRES_DATABASE=nocode_editor

# ── Phân quyền theo project ───────────────────────────────────────────────
# off    → quyết định ở Casbin domain '*' (hành vi cũ)
# shadow → vẫn quyết định như 'off', nhưng ghi vào audit_logs ai ĐANG bị chặn
#          mà bật 'on' sẽ cho qua (bật 'on' không lấy quyền của ai)
# on     → quyết định theo domain project:<slug>
#
# Bật 'on' KHÔNG lấy đi quyền của ai: enforce vẫn dò cả domain '*', nên tập
# quyền của 'on' là tập cha của 'off'. Nó chỉ THÊM đường vào cho thành viên
# project. Muốn giới hạn ai theo project thì phải gỡ role cấp system của họ bên
# authz — cờ này không làm thay được. Xem docs/superpowers/specs/.
AUTHZ_PROJECT_SCOPE=off
