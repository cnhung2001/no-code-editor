# ── Backend proxy config ───────────────────────────────────────────────────
PORT=8787

# AWS
AWS_REGION=ap-southeast-1
S3_BUCKET=ik-nocode-paywall
# Credentials: ưu tiên dùng IAM role / shared config (~/.aws). Hoặc đặt thẳng:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Presigned URL hết hạn (giây)
PRESIGN_TTL=900

# CloudFront (tuỳ chọn — để bật invalidate CDN khi publish)
CLOUDFRONT_DISTRIBUTION_ID=

# Bật S3 bucket versioning để rollback (true|false). Nếu false, backup ra <key>.bak
USE_S3_VERSIONING=true

# CORS origin cho frontend dev
CORS_ORIGIN=http://localhost:5173
