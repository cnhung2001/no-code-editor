# Chép thành ./.env trên host rồi điền. File .env đã bị .gitignore bắt (pattern `.env`).
# ⚠ CHỈ chứa biến RUNTIME. Biến VITE_* là build-time — truyền qua --build-arg
#   lúc build image (xem build-push.sh), đặt ở đây KHÔNG có tác dụng gì.

# Image ECR. Tag di động :prod — build-push.sh push đè mỗi lần, deploy.sh 'up --pull
# always' luôn kéo bản mới nhất, nên dòng này ĐẶT MỘT LẦN rồi thôi.
# Rollback: đổi tạm sang tag SHA bất biến (vd :7eafc7c) rồi chạy lại deploy.sh.
NOCODE_IMAGE=762871078113.dkr.ecr.ap-southeast-1.amazonaws.com/ik-nocode-editor:prod

NODE_ENV=production
PORT=8080

# ── Origin ──
# PHẢI là https + khớp từng byte với redirect URI đã đăng ký ở authz.
APP_BASE_URL=https://nocode.ikame-solution.com
AUTHZ_REDIRECT_URI=https://nocode.ikame-solution.com/auth/callback

# Cùng origin nên KHÔNG bật CORS. Để trống.
CORS_ORIGIN=

# ── authz ──
AUTHZ_SYSTEM_CODE=slaio
AUTHZ_API_KEY=__FILL__

# ── AWS (Lightsail không có IAM instance role → bắt buộc key tĩnh) ──

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=__FILL__
AWS_SECRET_ACCESS_KEY=__FILL__
S3_BUCKET=ik-nocode-paywall
PRESIGN_TTL=900
USE_S3_VERSIONING=true
CLOUDFRONT_DISTRIBUTION_ID=

# ── Machine translation ──
# ⚠ Bỏ trống → rơi về 'stub', nút Localize trả "[vi] text" mà KHÔNG báo lỗi.
MT_PROVIDER=google

# ── Postgres (mapping project + audit log) ────────────────────────────────
# DB chạy ở container riêng NGOÀI vòng blue-green (deploy/docker-compose.db.yml).
# Host = tên service trên network bmik_net, không phải localhost.
POSTGRES_HOST=nocode-db
POSTGRES_PORT=5432
POSTGRES_USER=nocode
POSTGRES_PASSWORD=__FILL__
POSTGRES_DATABASE=nocode_editor

# ── Phân quyền theo project ───────────────────────────────────────────────
# off | shadow | on — xem deploy/README.md §Phân quyền theo project.
# Bật 'on' KHÔNG lấy đi quyền của ai (domain '*' vẫn được dò). Nhưng chưa có
# p-rule `project:*` trên no-code-editor:layout thì cũng chưa có tác dụng gì.
AUTHZ_PROJECT_SCOPE=off
